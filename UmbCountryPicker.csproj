<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <!-- Serve wwwroot at /App_Plugins/UmbCountryPicker so Umbraco discovers umbraco-package.json -->
    <StaticWebAssetBasePath>App_Plugins/UmbCountryPicker</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <Version>17.0.0</Version>
    <PackageId>UmbCountryPicker</PackageId>
    <Product>UmbCountryPicker</Product>
    <Title>UmbCountryPicker</Title>
    <Description>A property editor for Umbraco CMS. It let's you pick a country from a list of countries.</Description>
    <PackageTags>umbraco plugin package umbraco-marketplace</PackageTags>
    <PackageProjectUrl>https://github.com/HamDerAndrew/UmbCountryPicker</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HamDerAndrew/UmbCountryPicker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>logo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Update="logo.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="17.7.0" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="17.7.0" />
    <PackageReference Include="EarthCountriesInfo" Version="10.2.1" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- The TypeScript sources are build inputs only; they are never compiled or packed. -->
  <ItemGroup>
    <Compile Remove="client\**" />
    <Content Remove="client\**" />
    <None Remove="client\**" />
    <EmbeddedResource Remove="client\**" />
  </ItemGroup>

  <!--
    The Marketplace reads umbraco-marketplace.json from the repository root, not from the nupkg,
    so keep it out of the package instead of shipping it to consumers as a content file.
  -->
  <ItemGroup>
    <Content Remove="umbraco-marketplace.json" />
    <None Include="umbraco-marketplace.json" />
  </ItemGroup>
</Project>
